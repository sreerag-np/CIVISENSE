# Copy to backend/.env (never commit .env). Real environment variables override this file.
CIVISENSE_ENV=development            # set to "production" when deployed (requires CIVISENSE_SECRET)
CIVISENSE_SECRET=change-me-to-a-long-random-string
CIVISENSE_ADMIN_EMAIL=admin@civisense.local
CIVISENSE_ADMIN_PASSWORD=change-me-now
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173   # not needed when the site is served by the backend itself
SEED_DEMO=0                          # 1 = add four labelled sample reports to an empty database
RATE_LIMIT_ENABLED=1
TRUST_PROXY=0                        # 1 only behind a proxy you control (Render, nginx); otherwise IPs can be spoofed
# GEMINI_API_KEY=                     # optional: image + text analysis; the keyword fallback is used without it
# GEMINI_MODEL=gemini-2.0-flash       # check Google's docs for the current model name
# CIVISENSE_DATA_DIR=/data            # where civisense.db and uploads/ live (put this on a persistent disk)
# MAX_IMAGE_MB=5
